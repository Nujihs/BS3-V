# ========================================
# 口琴谱生成器 Jianpu to BD · Vercel 版环境变量
# ========================================

# ---- PostgreSQL（必填）----
# Vercel 上推荐使用托管 PostgreSQL（Neon / Supabase / Vercel Postgres），
# 直接填 DATABASE_URL 即可，例如：
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://jianpu:jianpu123@localhost:5432/jianpu_db

# 本地分项配置（DATABASE_URL 未设置时使用）
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=jianpu_db
# PG_USER=jianpu
# PG_PASSWORD=jianpu123

# ---- Flask ----
FLASK_SECRET_KEY=jianpu-converter-secret-key-2024

# ---- 外部 OCR API（可选，仅图片识别需要）----
# 原项目 EasyOCR 无法部署到 Serverless，图片识别改为调用外部 OCR 服务。
# 未配置时：文本转换功能完全正常，图片上传会返回明确的配置提示。
# 兼容约定：POST multipart 图片到 OCR_API_URL，Authorization: Bearer <OCR_API_KEY>
OCR_API_URL=
OCR_API_KEY=
